# Choose one AI provider for narrative analysis. If omitted, the app still works
# with rule-based analysis as long as a market data API is configured.
VITE_AI_PROVIDER=groq

# Optional LLM keys
# VITE_GROQ_API_KEY=your_groq_key
# VITE_GEMINI_API_KEY=your_gemini_key
# VITE_ANTHROPIC_API_KEY=your_anthropic_key

# Choose a live market data source
# Supported values: groww, fmp, twelvedata
VITE_MARKET_DATA_PROVIDER=groww

# Groww market data
# Option 1: Use a generated daily access token
# VITE_GROWW_ACCESS_TOKEN=your_groww_access_token
#
# Option 2: Let the app generate the token using your API key + secret
# VITE_GROWW_API_KEY=your_groww_api_key
# VITE_GROWW_API_SECRET=your_groww_api_secret

# At least one of these is required for live quotes
# VITE_FMP_API_KEY=your_fmp_key
# VITE_TWELVE_DATA_API_KEY=your_twelve_data_key
